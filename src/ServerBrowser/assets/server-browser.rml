<rml>
  <head>
    <title>Community Server Browser</title>
    <script src="server-browser.lua"></script>
    <style>
      * { box-sizing: border-box; }
      body { width: 780px; margin: 0 auto; font-family: Tahoma; color: #eee; }
      .inner { background-color: #080808; padding: 8px; }
      h2 { color: #d6a845; margin: 1px 0 5px 0; font-size: 20px; text-align: center; }
      h3 { color: #efd07d; margin: 0; }
      /* Flat controls. theme.rcss skins every button with a ninepatch decorator at
         specificity (0,0,1), so these rules are scoped to .inner to outrank it
         regardless of sheet order. Removing the decorator is what flattens them. */
      .inner button {
        decorator: none;
        click-sound: none;
        margin: 0 0 0 4px;
        padding: 4px 9px;
        border: 1px;
        border-color: #4b422c;
        background-color: #17150f;
        color: #cfc5b2;
        font-size: 12px;
        font-effect: none;
        text-align: center;
        cursor: pointer;
      }
      .inner button:hover { border-color: #d6a845; background-color: #241f14; color: #fff3c4; }
      .inner button:active { background-color: #2f2717; }
      .inner button[disabled] { color: #5a554a; border-color: #2a2620; background-color: #131109; }
      .toolbar input, .field input {
        decorator: none;
        border: 1px;
        border-color: #4b422c;
        background-color: #12100b;
        color: #eee;
        padding: 3px 5px;
        font-size: 12px;
      }
      .toolbar input:focus, .field input:focus { border-color: #d6a845; }
      .tabs { display: flex; justify-content: center; margin-bottom: 6px; }
      .tabs button { width: 130px; }
      .tabs .active { color: #fff3c4; border-color: #d6a845; background-color: #735b2877; }
      .toolbar { display: flex; align-items: center; margin-bottom: 6px; }
      .toolbar input { flex: 1; min-width: 0; }
      /* Deliberately a span, not a button: the launcher's button skin sets its own
         height and padding, which overflowed the toolbar. */
      .clearSearch { width: 18px; margin-left: 6px; color: #cfc5b2; font-size: 14px; text-align: center; cursor: pointer; }
      .clearSearch:hover { color: #fff3c4; }

      .servers { width: 100%; height: 420px; overflow-y: auto; border: 1px; border-color: #80652e; }
      .server { display: flex; align-items: center; padding: 4px 8px; min-height: 62px; border-bottom: 1px; border-color: #493b20; flex-wrap: wrap; }
      .server-main { flex: 1; min-width: 0; }
      .server.favoriteServer { min-height: 0; padding: 3px 9px; background-color: #16232e; border-left: 3px; border-left-color: #4d7f9c; }
      .server.favoriteServer .description { display: none; }
      /* Favorites keep their badges but pack them two per row so the
         compact card stays short. All nodes still exist (stable DOM). */
      .server.favoriteServer .server-badges {
        width: 60px;
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: center;
        align-content: center;
      }
      .server.favoriteServer .server-badges .tag { font-size: 9px; margin-bottom: 1px; }
      .server.favoriteServer .server-badges .link-badge { width: auto; }
      .reorder { display: none; }
      .move-favorite { display: none; }
      /* Multi-launch checkbox on each card, left of the favorite star.
         Green to match the launch-account checkboxes and stay distinct
         from the gold favorite stars. */
      .server-heading > .checkbox { cursor: pointer; }
      .server-heading > .checkbox:hover { border-color: #7fdb88; }
      .server-heading > .checkbox.checked { background-color: #7fdb88; border-color: #7fdb88; }
      /* Chevron on favorite rows: click to expand the account picker. */
      .chevron { width: 15px; height: 15px; padding: 1px; margin-right: 4px; cursor: pointer; }
      .chevron:hover { background-color: #2d4757; }
      .chevron img { width: 13px; height: 13px; }
      /* Alternate-client path row inside the picker; hidden until the
         "Alternate client" checkbox in the picker header is ticked. */
      .altPathRow { display: flex; align-items: center; margin-bottom: 4px; }
      .alternatePath { flex: 1; min-width: 0; margin-right: 5px; }
      /* Expandable per-server account picker: an indented box on its own row
         beneath the card. Present in every row (stable DOM), toggled with
         .hidden. One account per line, alternating row tints for readability. */
      .picker {
        width: 100%;
        margin: 4px 0 2px 0;
        padding: 4px 6px 6px 24px;
        background-color: #10141c;
        border: 1px;
        border-color: #2a3444;
        border-radius: 3px;
      }
      .picker-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 3px; }
      .picker-summary { color: #8ec9e8; font-size: 11px; }
      .picker .pickRow {
        display: flex;
        align-items: center;
        padding: 2px 4px;
        cursor: pointer;
      }
      .picker .pickRow.even { background-color: #141a26; }
      .picker .pickRow.odd { background-color: #0d1119; }
      .picker .pickRow:hover { background-color: #241f14; }
      .pick-label { color: #cfc5b2; font-size: 11px; overflow: hidden; white-space: nowrap; }
      .picker .checkbox { margin-right: 4px; }
      .pickStar { width: 17px; height: 16px; margin-right: 4px; cursor: pointer; flex-shrink: 0; }
      .pickStar img { width: 15px; height: 14px; }
      .pickRow { cursor: pointer; }
      .server:hover { background-color: #735b2844; }
      .server.selected { background-color: #735b2877; border-left: 3px; border-left-color: #d6a845; }
      .server.filtered { display: none; }
      .server-heading { display: flex; align-items: center; }
      .title-block { display: flex; align-items: center; flex: 1; min-width: 180px; }
      .server h3 { color: #efd07d; font-size: 19px; line-height: 21px; margin: 0; }
      .title-block .endpoint { margin-left: 7px; font-size: 11px; white-space: nowrap; }
      .description { color: #cfc5b2; margin: 1px 0 0 22px; font-size: 12px; }
      .server-badges { display: flex; flex-direction: column; justify-content: center; align-items: stretch; width: 72px; margin-left: 8px; }
      .server-badges .link-badge { width: auto; }
      .server-badges .tag { margin-right: 0; margin-bottom: 2px; padding: 1px 4px; text-align: center; font-size: 10px; }
      .tag { display: inline-block; margin-right: 4px; padding: 2px 5px; color: #bdb6a4; background-color: #181611; border: 1px; border-color: #403929; border-radius: 3px; font-size: 11px; }
      .pve { color: #79cfff; }
      .pvp { color: #ff7474; }
      .statusStable { color: #7fdb88; }
      .statusDevelopment { color: #f0ce62; }
      .statusExperimental { color: #f3a35c; }
      .favorite { width: 18px; height: 17px; margin-right: 4px; cursor: pointer; }
      .favorite img { width: 17px; height: 17px; }
      .stats-cube { width: 66px; margin-left: 8px; background-color: #181611; border: 1px; border-color: #403929; border-radius: 3px; }
      .stats-cube .count { display: block; padding: 3px 0; color: #7fdb88; font-size: 16px; line-height: 18px; text-align: center; }
      .stats-cube .ping { display: block; padding: 2px 0; border-top: 1px; border-top-color: #403929; color: #8ec9e8; font-size: 10px; text-align: center; }
      .stats-cube .ping.offline { color: #ff7474; }
      .link-badge { width: 22px; height: 18px; margin-right: 0; margin-bottom: 3px; padding: 1px 3px; text-align: center; cursor: pointer; }
      .link-badge img { width: 14px; height: 14px; }
      .website-link { border-color: #3f6d88; background-color: #17262f; }
      .website-link:hover { background-color: #23414f; }
      .discord-icon { color: white; background-color: #312f48; border-color: #5865f2; }
      .discord-icon:hover { background-color: #7289da; }
      .discord-placeholder { border-color: #343434; }
      .discord-icon img { width: 14px; height: 14px; }
      .description { flex: 1; color: #cfc5b2; margin: 0; font-size: 12px; }
      .endpoint { color: #8ec9e8; }

      .launch-panel { min-height: 52px; border-top: 1px; border-color: #80652e; padding-top: 6px; }
      .checkbox {
        display: inline-block;
        width: 11px;
        height: 11px;
        margin-right: 4px;
        flex-shrink: 0;
        border: 1px;
        border-color: #4b422c;
        background-color: #12100b;
      }
      .checkbox.checked { background-color: #7fdb88; border-color: #7fdb88; }
      .pickRow:hover .checkbox { border-color: #d6a845; }
      .altToggle:hover .checkbox { border-color: #d6a845; }
      /* The launch row: one large primary action. */
      .launch-row { display: flex; align-items: center; margin-bottom: 5px; }
      .inner .launch { flex: 1; min-width: 0; margin-left: 0; border-color: #80652e; color: #efd07d; font-weight: bold; font-size: 15px; padding: 8px 9px; }
      .launch.disabled { color: #777; border-color: #4a4438; }
      /* Armed: bright filled red so a valid combo is unmissable. */
      .inner .launch.ready {
        border-color: #ff6b6b;
        color: #fff0f0;
        background-color: #c01818;
      }
      .inner .launch.ready:hover {
        border-color: #ff9a9a;
        background-color: #d82828;
      }
      /* Not armed: no fill at all — just the outline. Declared after .ready
         (source order beats same-specificity rules; RmlUi lacks :not()). */
      .inner .launch.plain {
        background-color: transparent;
        color: #cfc5b2;
        border-color: #4a4438;
      }
      .inner .launch.plain:hover {
        border-color: #d6a845;
        color: #efd07d;
      }
      /* Alt-client toggle button in the picker header. */
      .inner .altToggle {
        display: inline-flex;
        align-items: center;
        padding: 3px 8px;
        border: 1px;
        border-color: #4b422c;
        background-color: #17150f;
        color: #cfc5b2;
        font-size: 11px;
        cursor: pointer;
        white-space: nowrap;
      }
      .inner .altToggle:hover { border-color: #d6a845; color: #fff3c4; }
      .inner .altToggle.checked { color: #7fdb88; border-color: #7fdb88; }

      .account-actions { display: flex; justify-content: center; gap: 8px; margin-top: 6px; }
      /* The list fills the tab; the open bottom card overlaps its last rows. */
      .accounts-wrap { position: relative; flex: 1; min-height: 0; display: flex; flex-direction: column; }
      .accounts-list { flex: 1; min-height: 260px; overflow-y: auto; border: 1px; border-color: #80652e; }
      .account-row { display: flex; align-items: center; padding: 2px 7px; min-height: 24px; border-bottom: 1px; border-color: #493b20; }
      .account-row.even { background-color: #12100c; }
      .reorder-account { display: none; }
      /* Single-line account row, sized like the servers page: bold alias,
         muted username after it, clickable to edit. */
      .account-main { flex: 1; min-width: 0; cursor: pointer; display: flex; align-items: baseline; }
      .account-main:hover .account-alias { color: #fff3c4; }
      .account-alias { font-weight: bold; font-size: 14px; line-height: 18px; margin-right: 7px; color: #7fdb88; }
      .account-main .muted { font-size: 11px; }
      .account-log { width: 250px; margin-right: 6px; color: #8d877a; font-size: 11px; text-align: right; white-space: nowrap; overflow: hidden; }
      /* Bottom action card: overlaps the last rows of the account list. */
      .bottom-card {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #080808;
        border: 1px;
        border-color: #80652e;
        border-radius: 3px;
        padding: 8px;
      }
      .inner .danger { color: #ff8787; }
      .inner .danger:hover { border-color: #ff8787; color: #ffb3b3; }
      /* A header button whose section is open gets a lit border. */
      .inner .actions-active { border-color: #d6a845; color: #fff3c4; }
      .empty { padding: 20px; text-align: center; }
      .account-form, .settings { border-top: 1px; border-color: #80652e; padding-top: 7px; margin-top: 7px; }
      .account-form h3, .settings h3 { margin-bottom: 5px; }
      .form-row { display: flex; align-items: flex-end; margin-bottom: 5px; }
      .field { flex: 1; min-width: 0; margin-right: 5px; }
      .field label { display: block; color: #d6a845; font-size: 12px; }
      /* Form labels that mirror the account-row text style they produce. */
      .field-label-alias { display: block; color: #7fdb88; font-weight: bold; font-size: 14px; }
      .field-label-username { display: block; color: #8d877a; font-size: 11px; }
      .field-label { display: block; color: #d6a845; font-size: 12px; }

      /* Last so it beats same-specificity display rules such as .tag. */
      .hidden { display: none; }
      .field input { width: 100%; }
      .default-server { flex: 1; color: #8ec9e8; }
      .muted { color: #8d877a; }
      .error { color: #ff8787; }
      .loading { color: #d6a845; padding: 12px; }
    </style>
  </head>
  <body class="window">
    <div class="inner" id="server-browser" />
  </body>
</rml>
